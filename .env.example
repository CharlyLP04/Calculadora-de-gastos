# Configuración de Google Firebase (Opcional si lo configuras desde la interfaz)
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=tu-proyecto
# VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
# VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# O bien como un solo JSON:
# VITE_FIREBASE_CONFIG={"apiKey":"...","projectId":"..."}

# Para el servidor local de sincronización (Node.js)
SYNC_TOKEN=un_token_secreto_de_al_menos_32_caracteres_aleatorios
PORT=3000
